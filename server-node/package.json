{
  "name": "strudel-mcp-server",
  "version": "1.0.0",
  "description": "Strudel MCP WebSocket Server (Node.js + TypeScript)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc --skipLibCheck",
    "build:strict": "tsc",
    "start": "bun run dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest test/mcp.test.ts",
    "test:integration": "jest test/integration.test.ts --testTimeout=10000",
    "test:security": "jest test/security.test.ts --testTimeout=15000",
    "test:performance": "jest test/performance.test.ts --testTimeout=30000",
    "test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit",
    "test:validate": "jest --coverage --passWithNoTests --coverageThreshold='{\"global\":{\"statements\":60,\"branches\":30,\"functions\":50,\"lines\":60}}'",
    "test:basic": "node dist/minimal-index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "quality-check": "npm run lint && npm run test:validate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@modelcontextprotocol/servers": "github:modelcontextprotocol/servers",
    "express": "^4.18.2",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "jest-junit": "^16.0.0",
    "pino": "^10.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "winston": "^3.18.3"
  }
}